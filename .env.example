# Local secrets template. Copy to .env (gitignored, NEVER commit real values).

# Fine-grained GitHub PAT limited to THIS repo only (Contents: read/write).
# Mint at https://github.com/settings/personal-access-tokens — see TEMPLATE.md.
GITHUB_TOKEN=

# Overlay mode only: fine-grained PAT for the target repo cloned inside.
TARGET_GITHUB_TOKEN=
