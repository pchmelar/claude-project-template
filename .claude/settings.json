{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "WebSearch",
      "Read(//private/tmp/claude-{{UID}}/**)",
      "Read(//tmp/claude-{{UID}}/**)"
    ],
    "deny": [
      "Read(//**/.env)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_ENV_FILE\" ] && printf 'eval \"$(devbox shellenv --init-hook --config %q)\" >/dev/null\\nexport DEVBOX_SHELL_ENABLED=1\\n' \"$CLAUDE_PROJECT_DIR\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  }
}
